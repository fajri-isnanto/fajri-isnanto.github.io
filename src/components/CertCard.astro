---
export interface Props {
    badgeImage: string;
    title: string;
    issuer: string;
    description: string;
    tags: string[];
    issuedDate: string;
    expiration?: string;
    verifyUrl: string;
    arrowIcon?: string;
    verifiedIcon?: string;
}

import {Icon} from "astro-icon/components";

const {
    badgeImage, title, issuer, description,
    tags, issuedDate, expiration = "No Expiration", verifyUrl,
    arrowIcon = "arrow-new-sharp",
    verifiedIcon = "verified-new",
} = Astro.props;

const formatDate = (dateStr: string | undefined) => {
    if (!dateStr) return "No Expiration";
    const d = new Date(dateStr + "T00:00:00");
    return d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
};

---

<div class="cert-card">
    <!-- Top red bar -->
    <div class="cert-card__bar"></div>

    <!-- Body: 2 columns - badge left, content right -->
    <div class="cert-card__body">
        <!-- Left: badge -->
        <div class="cert-card__left">
            <img src={badgeImage} alt={`${title} badge`} class="cert-card__badge" loading="lazy" />
        </div>

        <!-- Right: content -->
        <div class="cert-card__right">
            <span class="cert-card__pill">
                <Icon name={verifiedIcon} size={14} />
                VERIFIED
            </span>
            <h3 class="cert-card__title">{title}</h3>
            <div class="cert-card__divider"></div>
            <p class="cert-card__issuer">{issuer}</p>
            <p class="cert-card__desc">{description}</p>
            <div class="cert-card__tags">
                {tags.map((tag) => <span class="cert-card__tag">{tag}</span>)}
            </div>
        </div>
    </div>

    <!-- Divider -->
    <div class="cert-card__sep"></div>

    <!-- Footer: 3 columns - Issued | Expiration | Verify -->
    <div class="cert-card__footer">
        <span class="cert-card__meta-item">
            <Icon name="calender-new" size={21} />
            Issued {formatDate(issuedDate)}
        </span>
        <span class="cert-card__meta-item">
            <Icon name="expire-new" size={21} />
            {formatDate(expiration)}
        </span>
        <a href={verifyUrl} target="_blank" rel="noopener noreferrer" class="cert-card__verify">
            Verify on Credly
            <Icon name={arrowIcon} size={35} />
        </a>
    </div>
</div>

<style>
    .cert-card {
        display: flex;
        flex-direction: column;
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        transition: transform 150ms ease, box-shadow 150ms ease;
        height: 100%;
        font-family: "Inter Variable", "Geist", "SF Pro Display", system-ui, sans-serif;
    }
    .cert-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 40px rgba(0,0,0,.1);
    }

    .cert-card__bar {
        height: 4px;
        background: #ee0000;
        flex-shrink: 0;
    }

    /* Body: 2 columns */
    .cert-card__body {
        display: flex;
        gap: 24px;
        padding: 24px 24px 0 24px;
    }

    /* Left column: badge */
    .cert-card__left {
        flex-shrink: 0;
    }

    .cert-card__badge {
        width: 125px;
        height: auto;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 1px 4px rgba(0,0,0,.08);
    }

    .cert-card__pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #ecfdf5;
        color: #089153;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: .08em;
        text-transform: uppercase;
        padding: 5px 12px;
        border-radius: 999px;
        white-space: nowrap;
        margin-bottom: 10px;
        box-shadow: 0 0 0 1px rgba(8,145,83,.2), 0 1px 3px rgba(0,0,0,.1);
    }

    /* Right column: content */
    .cert-card__right {
        flex: 1;
        min-width: 0;
    }

    .cert-card__title {
        font-family: "Inter Variable", "Inter", sans-serif;
        font-size: 24px;
        font-weight: 600;
        line-height: 1.15;
        letter-spacing: -0.02em;
        color: #111827;
        margin: 0 0 8px 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .cert-card__divider {
        width: 36px;
        height: 4px;
        background: #ee0000;
        border-radius: 2px;
        margin-bottom: 8px;
    }

    .cert-card__issuer {
        font-family: "Inter Variable", sans-serif;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #EE0000;
        margin: 0 0 6px 0;
    }

    .cert-card__desc {
        font-family: "Inter Variable", sans-serif;
        font-size: 13px;
        font-weight: 400;
        line-height: 1.7;
        letter-spacing: -0.005em;
        color: #6B7280;
        margin: 0 0 10px 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .cert-card__tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .cert-card__tag {
        display: inline-flex;
        align-items: center;
        font-family: "Inter Variable", sans-serif;
        font-size: 13px;
        font-weight: 500;
        border: 1px solid #e6e8eb;
        border-radius: 999px;
        padding: 4px 10px;
        line-height: 1;
        color: #1a1a1a;
    }

    .cert-card__sep {
        border-top: 1px solid #e6e8eb;
        margin: 24px 24px 0 24px;
    }

    /* Footer: 3 columns */
    .cert-card__footer {
        display: grid;
        grid-template-columns: 1fr 1fr auto;
        gap: 16px;
        padding: 18px 24px 24px 24px;
        margin-top: auto;
        align-items: center;
    }

    .cert-card__meta-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #6B7280;
        font-size: 12px;
        font-weight: 500;
        white-space: nowrap;
    }

    .cert-card__meta-item svg {
        color: #C70C12;
    }

    .cert-card__verify {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border: 1.5px solid #EE0000;
        color: #EE0000;
        font-weight: 600;
        font-size: 14px;
        line-height: 1;
        padding: 8px 14px;
        border-radius: 8px;
        white-space: nowrap;
        transition: background 150ms ease, color 150ms ease;
    }

    .cert-card__verify:hover {
        background: #ee0000;
        color: #fff;
    }
</style>

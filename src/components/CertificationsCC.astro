---
import { ME } from '@/config';
import CertCard from './CertCard.astro';

const { certifications } = ME;
---

<div class="relative left-1/2 -translate-x-1/2 w-screen">
    <div class="max-w-[96rem] mx-auto px-4 mt-10">
        <h2 class="text-3xl font-bold text-[#111827] mb-8">Certifications</h2>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            {certifications.map((cert) => (
                <CertCard
                    badgeImage={cert.badgeImage}
                    title={cert.name}
                    issuer={cert.issuer}
                    description={cert.description}
                    tags={cert.skills}
                    issuedDate={cert.issueDate}
                    expiration={cert.expiration}
                    verifyUrl={cert.credlyUrl}
                    verifiedIcon={cert.shortName === "RHCSC" ? "verified-new-sharp" : "verified-new"}
                />
            ))}
        </div>
    </div>
</div>

---
import { ME } from '@/config';
import CertCard from './CertCard.astro';

const { certifications } = ME;
---

<div class="relative left-1/2 -translate-x-1/2 w-screen">
    <div class="max-w-[105rem] mx-auto px-4 mt-10">
        <div class="certifications-grid grid grid-cols-1 gap-6 mt-10">
            {certifications.map((cert, i) => (
                <CertCard
                    badgeImage={cert.badgeImage}
                    title={cert.name}
                    issuer={cert.issuer}
                    description={cert.description}
                    tags={cert.skills}
                    issuedDate={cert.issueDate}
                    expiration={cert.expiration}
                    verifyUrl={cert.credlyUrl}
                    verifiedIcon={cert.shortName === "RHCSC" ? "verified-new-sharp" : "verified-new"}
                />
            ))}
        </div>
    </div>
</div>

<style is:global>
    .certifications-grid {
        grid-template-columns: 1fr;
        max-width: 80rem;
        margin: 0 auto;
    }
    @media (min-width: 1024px) {
        .certifications-grid {
            grid-template-columns: repeat(3, 520px);
        }
    }
</style>
